{
  "manifest_version": 3,
  "name": "TruthLens - AI Fact Checker",
  "version": "1.0.0",
  "description": "Fact-check any text instantly with AI",
  "permissions": ["contextMenus", "activeTab", "storage", "scripting"],
  "host_permissions": [
  "http://localhost:8000/*",
  "https://truthlens-api-z46t.onrender.com/*"
],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ],
  "action": { "default_popup": "popup.html" }
}
